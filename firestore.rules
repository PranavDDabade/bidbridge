rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Assumes user roles are stored at /users/{uid} in a "role" field.
    function currentUserIs(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function buyerOwnsRfq(rfqId, buyerId) {
      return exists(/databases/$(database)/documents/rfqs/$(rfqId))
        && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.buyerId == buyerId;
    }

    function rfqIsOpen(rfqId) {
      return exists(/databases/$(database)/documents/rfqs/$(rfqId))
        && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.status == 'open';
    }

    function validBidDocument(data) {
      return data.keys().hasAll([
          'sellerId', 'sellerName', 'rfqId', 'price',
          'leadTimeDays', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'sellerId', 'sellerName', 'rfqId', 'price',
          'leadTimeDays', 'notes', 'createdAt',
          'updatedAt', 'status'
        ])
        && data.sellerId is string
        && data.sellerName is string
        && data.rfqId is string
        && data.rfqId.size() > 0
        && data.price is number
        && data.price > 0
        && data.price <= 10000000
        && data.leadTimeDays is int
        && data.leadTimeDays >= 0
        && data.leadTimeDays <= 365
        && data.notes is string
        && data.notes.size() <= 2000
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('status' in data)
            || data.status in ['submitted', 'awarded', 'not_selected']);
    }

    // RFQ schema based on fields shown in the shared component/rules.
    // Adjust item validation if your existing RFQ form uses additional fields.
    function validRfqDocument(data) {
      return data.keys().hasAll([
          'buyerId', 'status', 'items', 'location', 'neededBy'
        ])
        && data.keys().hasOnly([
          'buyerId', 'buyerName', 'status', 'items', 'location',
          'neededBy', 'rawText', 'selectedBidId', 'createdAt',
          'updatedAt', 'aiAudit'
        ])
        && data.buyerId is string
        && data.status in ['open', 'closed']
        && data.items is list
        && data.location is string
        && data.neededBy is string
        && (!('buyerName' in data) || data.buyerName is string)
        && (!('rawText' in data) || data.rawText is string)
        && (!('selectedBidId' in data)
            || data.selectedBidId == null
            || data.selectedBidId is string)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      // Keep your existing user creation/profile update rules here if needed.
    }

    match /bids/{bidId} {
      allow create: if currentUserIs('seller')
        && validBidDocument(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        && (!('status' in request.resource.data)
            || request.resource.data.status == 'submitted')
        && rfqIsOpen(request.resource.data.rfqId);

      allow get, list: if signedIn()
        && (
          resource.data.sellerId == request.auth.uid
          || (
            currentUserIs('buyer')
            && buyerOwnsRfq(resource.data.rfqId, request.auth.uid)
          )
        );

      allow update: if currentUserIs('seller')
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.rfqId == resource.data.rfqId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['price', 'leadTimeDays', 'notes', 'updatedAt'])
        && rfqIsOpen(resource.data.rfqId)
        && validBidDocument(request.resource.data);

      allow delete: if false;
    }

    match /rfqs/{rfqId} {
      allow create: if currentUserIs('buyer')
        && validRfqDocument(request.resource.data)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'open'
        && (!('selectedBidId' in request.resource.data)
            || request.resource.data.selectedBidId == null);

      allow get, list: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || (
            currentUserIs('seller')
            && resource.data.status in ['open', 'closed']
          )
        );

      allow update: if currentUserIs('buyer')
        && resource.data.buyerId == request.auth.uid
        && (
          (
            resource.data.status == 'open'
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['items', 'location', 'neededBy', 'updatedAt', 'rawText'])
            && validRfqDocument(request.resource.data)
          )
          ||
          (
            resource.data.status == 'open'
            && request.resource.data.status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'selectedBidId', 'updatedAt'])
            && request.resource.data.selectedBidId is string
            && exists(
              /databases/$(database)/documents/bids/$(request.resource.data.selectedBidId)
            )
            && get(
              /databases/$(database)/documents/bids/$(request.resource.data.selectedBidId)
            ).data.rfqId == rfqId
          )
        );

      allow delete: if false;
    }

    // Deny all access not explicitly granted above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
