rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ AUTHENTICATION FUNCTIONS ============
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ============ VALIDATION FUNCTIONS ============

    // Check if user exists and has valid role
    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function hasRole(uid, role) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == role;
    }

    // RFQ validation helpers
    function rfqIsOpen(rfqId) {
      return get(/databases/$(database)/documents/rfqs/$(rfqId)).data.status == 'open';
    }

    function rfqIsAwarded(rfqId) {
      return get(/databases/$(database)/documents/rfqs/$(rfqId)).data.status == 'awarded';
    }

    function rfqBelongsTo(rfqId, uid) {
      return get(/databases/$(database)/documents/rfqs/$(rfqId)).data.buyerId == uid;
    }

    // Bid validation helpers
    function bidBelongsTo(bidId, uid) {
      return get(/databases/$(database)/documents/bids/$(bidId)).data.sellerId == uid;
    }

    // Immutability check: verify critical fields don't change
    function immutableFieldsUnchanged(oldData, newData, fields) {
      return fields.all(field, oldData[field] == newData[field]);
    }

    // Price validation: realistic bounds (0 - 10M)
    function validPrice(price) {
      return price > 0 && price < 10000000;
    }

    // Lead time validation: 1-365 days
    function validLeadTime(days) {
      return days > 0 && days <= 365;
    }

    // ============ USERS COLLECTION ============
    match /users/{uid} {
      // Read: Only self can read own profile
      allow read: if signedIn() && myUid() == uid;

      // Create: Self-auth, valid role, user doesn't exist yet
      allow create: if signedIn()
                    && myUid() == uid
                    && request.resource.data.role in ['buyer', 'seller']
                    && request.resource.data.size() == 3  // role, name, createdAt only
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;

      // Update: Self-auth only, role is immutable, name is optional
      allow update: if signedIn()
                    && myUid() == uid
                    && resource.data.role == request.resource.data.role
                    && request.resource.data.role in ['buyer', 'seller'];

      // Delete: Never allowed
      allow delete: if false;
    }

    // ============ RFQS COLLECTION ============
    match /rfqs/{rfqId} {
      // CREATE: Buyer only, ownership verification, valid initial state
      allow create: if signedIn()
                    && myRole() == 'buyer'
                    && request.resource.data.buyerId == myUid()
                    && request.resource.data.status == 'open'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.location is string
                    && request.resource.data.neededBy is string
                    && userExists(myUid());

      // READ: Creator or seller can read
      allow read: if signedIn()
                  && (resource.data.buyerId == myUid() || myRole() == 'seller');

      // UPDATE: Creator only, with strict ABAC rules
      allow update: if signedIn()
                    && myUid() == resource.data.buyerId
                    && immutableFieldsUnchanged(resource.data, request.resource.data, ['buyerId', 'createdAt'])
                    // Only creator can edit BEFORE bids arrive
                    && (resource.data.status == 'open' ||
                        // Or: status change from 'open' to 'awarded' (with awardedTo field)
                        (resource.data.status == 'open'
                         && request.resource.data.status == 'awarded'
                         && request.resource.data.awardedTo is string
                         && request.resource.data.awardedTo.size() > 0));

      // DELETE: Never allowed (audit trail)
      allow delete: if false;
    }

    // ============ BIDS COLLECTION ============
    match /bids/{bidId} {
      // CREATE: Seller only, valid bid, RFQ must be open
      allow create: if signedIn()
                    && myRole() == 'seller'
                    && request.resource.data.sellerId == myUid()
                    && request.resource.data.rfqId is string
                    && rfqIsOpen(request.resource.data.rfqId)
                    && request.resource.data.price is number
                    && validPrice(request.resource.data.price)
                    && request.resource.data.leadTimeDays is number
                    && validLeadTime(request.resource.data.leadTimeDays)
                    && request.resource.data.notes is string
                    && userExists(myUid());

      // READ: Seller (own bid) or buyer (of that RFQ)
      allow read: if signedIn()
                  && (resource.data.sellerId == myUid()
                      || rfqBelongsTo(resource.data.rfqId, myUid()));

      // UPDATE: Seller only, immutable RFQ link, only when RFQ open
      allow update: if signedIn()
                    && myUid() == resource.data.sellerId
                    && resource.data.rfqId == request.resource.data.rfqId
                    && rfqIsOpen(resource.data.rfqId)
                    && immutableFieldsUnchanged(resource.data, request.resource.data, ['rfqId', 'sellerId', 'createdAt'])
                    && request.resource.data.price is number
                    && validPrice(request.resource.data.price)
                    && request.resource.data.leadTimeDays is number
                    && validLeadTime(request.resource.data.leadTimeDays);

      // DELETE: Never allowed (audit trail)
      allow delete: if false;
    }
  }
}